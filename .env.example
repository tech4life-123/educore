# -----------------------------------------------------------------------------
# EduCore environment variables
# Copy to .env.local for local development. NEVER commit real values.
# On Vercel: Project → Settings → Environment Variables.
# -----------------------------------------------------------------------------

# --- Public (shipped to the browser; safe because RLS protects all data) -----
# Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_...) — or the legacy "anon" JWT key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# --- Server-only secret (NO NEXT_PUBLIC_ prefix — never exposed to browsers) --
# Optional. Only needed for the /platform (super admin) school directory.
# Bypasses Row Level Security: keep it out of client code, logs and screenshots.
SUPABASE_SERVICE_ROLE_KEY=

# --- Multi-school domains (server-only) ---------------------------------------
# Comma-separated hostnames that are the app itself, never a school's domain
# (e.g. a custom root domain you sign in through today). Leave UNSET to keep
# this feature entirely off — see ARCHITECTURE.md §21.2. Your own *.vercel.app
# domain and localhost never need listing; they're always treated as the app.
# EDUCORE_PRIMARY_HOSTS=educore.example.com

# --- EduCore AI (server-only — never NEXT_PUBLIC_) ------------------------------
# The assistant stays off until ANTHROPIC_API_KEY is set (and the service-role
# key above, which the usage limits need). Get a key at console.anthropic.com.
ANTHROPIC_API_KEY=
# AI_PROVIDER=anthropic            # or "mock" for local development without a key
# AI_MODEL=claude-haiku-4-5-20251001  # fastest, lowest cost; e.g. claude-sonnet-5 for more capability
# AI_ENABLED=true                  # "false" switches the assistant off everywhere
# AI_MAX_OUTPUT_TOKENS=800         # longest reply
# AI_TIMEOUT_MS=45000
# AI_USER_REQUESTS_PER_MINUTE=6
# AI_USER_REQUESTS_PER_DAY=60
# AI_SCHOOL_REQUESTS_PER_DAY=1500
